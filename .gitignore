# Ignore directories generated by Composer
.ddev/
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings.php
/web/sites/*/settings.*.php
/web/sites/*/services.local.yml
/web/sites/*/services.yml
/web/sites/*/development.services.yml

# Ignore Drupal's file directory
/web/sites/*/files/
/private/
# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/
/.env

# Ignore files generated by VSCode
.vscode
drush

# Ignore SQL files
/mariadb-init/*.sql
*.mysql

# Ignore files and directories by front
node_modules
/web/themes/custom/**/package-lock.json
/web/themes/custom/**/styleguide/

#other files and folders
.DS_Store
nbproject
*.sql
*.sql.gz
*.bk
*.bak
*.log
*.log2
*.ini
*.gz
/nbproject/private/
web/error_log
/.ssh
.Xauthority
.bash_history
.cache/
.config/
.local/
.viminfo
.drush/
